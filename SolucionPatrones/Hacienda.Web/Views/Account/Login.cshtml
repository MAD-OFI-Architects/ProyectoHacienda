@model Hacienda.Web.Models.LoginViewModel
@{
    Layout = null; // No usar el layout principal
    ViewData["Title"] = "Iniciar Sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HaciendaSoft</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, var(--aw-green-soft) 0%, #E0F2FE 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        .login-card {
            max-width: 450px;
            width: 100%;
        }
    </style>
</head>
<body>
    <div class="login-card aw-card p-4 p-md-5">
        <div class="text-center mb-4">
            <h1 class="h2 fw-bold" style="color: var(--aw-green);">HaciendaSoft</h1>
            <p class="text-muted">Bienvenido de nuevo</p>
        </div>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Usuario" />
                <label asp-for="Username"></label>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-4">
                <input asp-for="Password" class="form-control" placeholder="Contraseña" />
                <label asp-for="Password"></label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn aw-btn aw-btn-primary btn-lg">Ingresar</button>
            </div>
        </form>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
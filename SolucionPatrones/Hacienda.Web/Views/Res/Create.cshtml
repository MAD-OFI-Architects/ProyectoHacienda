@using Hacienda.Domain.Entities

@{
    ViewData["Title"] = "Agregar Res";
    var potreros = ViewBag.Potreros as List<Potrero>;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Encabezado -->
            <div class="aw-page-header mb-4">
                <h1 class="display-6 fw-bold mb-1" style="color: var(--aw-text);">
                    Agregar Nueva Res
                </h1>
                <p class="text-muted mb-0">Registra una nueva res en un potrero.</p>
            </div>

            <!-- Mensaje de error -->
            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>@ViewBag.Mensaje</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Formulario -->
            <div class="aw-card aw-reveal">
                <div class="aw-card-header">Información de la Res</div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label for="potreroId" class="form-label fw-bold">Potrero</label>
                                @if (potreros != null && potreros.Any())
                                {
                                    <select name="potreroId" class="form-select form-select-lg" required>
                                        <option value="">-- Seleccione --</option>
                                        @foreach (var potrero in potreros)
                                        {
                                            <option value="@potrero.Identificacion">@potrero.Identificacion (@potrero.Tipo)</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <div class="alert alert-warning p-2">
                                        <small>No hay potreros. <a asp-controller="Potrero" asp-action="Create" class="a-clean">Crear uno</a></small>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6 mb-4">
                                <label for="nombre" class="form-label fw-bold">Nombre de la Res</label>
                                <input name="nombre" type="text" class="form-control form-control-lg" placeholder="Ej: Pinta" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label for="edad" class="form-label fw-bold">Edad (meses)</label>
                                <input name="edad" type="number" class="form-control form-control-lg" placeholder="Ej: 6" min="0" max="120" required />
                                <small class="form-text text-muted">Terneros: 0-12, Cebones: 13-48, Novillos: 49+</small>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label for="peso" class="form-label fw-bold">Peso (kg)</label>
                                <input name="peso" type="number" class="form-control form-control-lg" placeholder="Ej: 250" min="1" max="2000" required />
                            </div>
                        </div>

                        <!-- Botones -->
                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Index" class="btn aw-btn aw-btn-secondary me-2">Cancelar</a>
                            <button type="submit" class="btn aw-btn aw-btn-primary">Agregar Res</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@model Hacienda.Domain.Entities.Chip
@using Hacienda.Domain.Entities
@using Hacienda.Domain.Enums
@{
    ViewData["Title"] = "📡 Instalar Chip";
    var reses = ViewBag.Reses as List<(Potrero Potrero, Res Res)>;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="aw-page-header mb-4">
                <h1 class="display-6 fw-bold mb-1" style="color: var(--aw-text);">
                    Instalar Chip en Res
                </h1>
                <p class="text-muted mb-0">Asigna un chip de geolocalización a una res del ganado.</p>
            </div>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-@TempData["TipoMensaje"] alert-dismissible fade show" role="alert">
                    <strong>@TempData["Mensaje"]</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="aw-card aw-reveal">
                <div class="aw-card-header">Datos del Chip</div>
                <div class="card-body p-4">
                    <form asp-action="Instalar" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="resId" class="form-label fw-bold">Res</label>
                            <select name="resId" id="resId" class="form-select form-select-lg" required>
                                <option value="">-- Seleccione una res --</option>
                                @if (reses != null)
                                {
                                    foreach (var (potrero, res) in reses)
                                    {
                                        <option value="@res.Id">@res.Nombre (@potrero.Identificacion.Valor) - @(res.Chip != null ? "YA TIENE CHIP" : "Sin chip")</option>
                                    }
                                }
                            </select>
                            <small class="form-text text-muted">Solo se muestran reses sin chip instalado.</small>
                        </div>

                        <div class="mb-4">
                            <label for="numeroSerie" class="form-label fw-bold">Número de Serie del Chip</label>
                            <input type="text" class="form-control form-control-lg" id="numeroSerie" name="numeroSerie"
                                   required placeholder="Ej: CHIP-001-A1B2" maxlength="50" />
                            <small class="form-text text-muted">Identificador único del chip GPS.</small>
                        </div>

                        <div class="alert alert-info border-0 d-flex align-items-start" style="background: #E3F2FD;">
                            <span class="material-icons-outlined me-2" style="color: #1976D2;">info</span>
                            <div>
                                <strong>Nota:</strong> El chip se instalará con estado <strong>Activo</strong> y la fecha de instalación será la actual.
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Index" class="btn aw-btn aw-btn-secondary me-2">Cancelar</a>
                            <button type="submit" class="btn aw-btn aw-btn-primary">
                                <span class="material-icons-outlined" style="font-size: 1rem; vertical-align: sub;">check</span>
                                Instalar Chip
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
